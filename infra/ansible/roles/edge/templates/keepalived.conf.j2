global_defs {
    router_id {{ inventory_hostname }}
    vrrp_skip_check_adv_addr
    vrrp_garp_interval 0
    vrrp_gna_interval 0
}

vrrp_script check_services {
    script "/usr/local/bin/health-check"
    interval 5
    weight 50
    fall 3
    rise 2
}

vrrp_instance VI_1 {
    state BACKUP
    interface eth0
    virtual_router_id {{ keepalived_router_id }}
    priority {{ edge_priority }}
    advert_int 1

    authentication {
        auth_type PASS
        auth_pass {{ keepalived_password }}
    }

    virtual_ipaddress {
        {{ vip }}/24 dev eth0 label eth0:vip
    }

    track_script {
        check_services
    }

    notify_master "/usr/local/bin/edge-master.sh"
    notify_backup "/usr/local/bin/edge-backup.sh"
    notify_fault "/usr/local/bin/edge-fault.sh"

    # Prevent split-brain
    nopreempt
}