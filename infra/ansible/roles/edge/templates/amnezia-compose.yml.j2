version: '3.8'

services:
  amnezia:
    image: ghcr.io/amnezia-vpn/amnezia-server:latest
    container_name: amnezia-vpn
    restart: unless-stopped

    network_mode: host

    cap_add:
      - NET_ADMIN
      - SYS_MODULE

    sysctls:
      - net.ipv4.ip_forward=1
      - net.ipv6.conf.all.forwarding=1

    volumes:
      - /opt/edge-shared/amnezia/data:/data
      - /lib/modules:/lib/modules:ro

    environment:
      - VPN_PORT={{ vpn_port }}
      - VPN_PROTOCOL=udp
      - DNS_SERVER=1.1.1.1,8.8.8.8
      - ALLOWED_IPS=0.0.0.0/0,::/0

    healthcheck:
      test: ["CMD", "pgrep", "amnezia"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 30s