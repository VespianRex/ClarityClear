# Proxmox Connection
PM_API_URL=https://YOUR_PROXMOX_IP:8006/api2/json
PM_USER=terraform@pve!terraform-token  # Use API token instead of root
PM_PASSWORD=YOUR_API_TOKEN_HERE
PM_NODE=YOUR_NODE_NAME
PM_NODE2=YOUR_SECOND_NODE  # Or same as PM_NODE if single node
PM_STORAGE=local-lvm
PM_BRIDGE=vmbr0

# Network Configuration
VIP=192.168.0.50           # Virtual IP for HA
LAN_SUBNET=192.168.0.0/24  # Your LAN subnet
NFS_SERVER=192.168.0.55    # NFS server IP
NFS_PATH=/export/edge-shared

# Domain & Certificates
DOMAIN_BASE=your-domain.com
LE_EMAIL=admin@your-domain.com
PUBLIC_IP=YOUR_PUBLIC_IP

# SSH Configuration
SSH_PUBKEY="YOUR_SSH_PUBLIC_KEY"
ADMIN_USER=YOUR_ADMIN_USER

# Template IDs
DEBIAN_TEMPLATE_ID=9000
ALPINE_TEMPLATE_ID=9001

# VM Names
EDGE_A_NAME=edge-a
EDGE_B_NAME=edge-b
APP_VM_NAME=clarity-app
MONITORING_VM_NAME=monitoring
PBS_VM_NAME=pbs-backup
NFS_VM_NAME=nfs-storage

# VPN Configuration
VPN_PROVIDER=amnezia
VPN_PORT=51820

# Backup Configuration
RESTIC_PASSWORD=GENERATE_STRONG_PASSWORD_HERE
RESTIC_REPO=/opt/clarity/backups
BACKUP_S3_BUCKET=clarity-backups
BACKUP_S3_KEY=YOUR_S3_ACCESS_KEY
BACKUP_S3_SECRET=YOUR_S3_SECRET_KEY

# Monitoring
GRAFANA_ADMIN_PASSWORD=GENERATE_STRONG_PASSWORD_HERE
PROMETHEUS_RETENTION_DAYS=30

# Keepalived
KEEPALIVED_PASSWORD=GENERATE_STRONG_PASSWORD_HERE
KEEPALIVED_ROUTER_ID=51

# PBS
PBS_ADMIN_PASSWORD=GENERATE_STRONG_PASSWORD_HERE